<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "https://www.elkarte.net/site/package-info">
<package-info xmlns="https://www.elkarte.net/site/package-info" xmlns:elk="https://www.elkarte.net/">
	<id>Spuds:fb4elk</id>
	<name>Fancy Box 4 ElkArte</name>
	<version>2.0.0</version>
	<type>addon</type>
	<license><![CDATA[
/**
 * Fancy Box 4 ElkArte
 *
 * @author spuds
 * @license MPL 1.1 http://mozilla.org/MPL/1.1/
 *
 * @version 2.0.0
 */
]]></license>
	<install for="2.0.0 Beta 1 - 2.0.99">
		<readme parsebbc="true">readme.txt</readme>
		<license type="inline">This ElkArte addon is released under a MPL V1.1 license, a copy of it with its provisions is included with the package.</license>

		<require-dir name="languages/Fancybox" destination="LANGUAGEDIR">The language strings</require-dir>
		<require-dir name="scripts" destination="THEMEDIR">The Fancybox JS to create the lightbox</require-dir>>
		<require-dir name="css" destination="THEMEDIR">The Fancybox CSS</require-dir>

		<require-file name="sources/Fancybox.php" destination="ADDONSDIR">Main processing file</require-file>

		<hook hook="integrate_load_theme" file="ADDONSDIR/Fancybox.php" function="ilt_fb4elk" />
		<hook hook="integrate_admin_areas" file="ADDONSDIR/Fancybox.php" function="iaa_fb4elk" />
		<hook hook="integrate_sa_modify_modifications" file="ADDONSDIR/Fancybox.php" function="imm_fb4elk" />

		<credits url="www.elkarte.net" license="MPL 1.1" copyright="spuds">Fancybox 4 Elkarte</credits>

		<redirect url="?action=admin;area=addonsettings;sa=fancybox" timeout="5000" />
	</install>

	<uninstall for="2.0.0 Beta 1 - 2.0.99">
		<hook reverse="true" hook="integrate_load_theme" file="ADDONSDIR/Fancybox.php" function="ilt_fb4elk" />
		<hook reverse="true" hook="integrate_admin_areas" file="ADDONSDIR/Fancybox.php" function="iaa_fb4elk" />
		<hook reverse="true" hook="integrate_sa_modify_modifications" file="ADDONSDIR/Fancybox.php" function="imm_fb4elk" />

        <remove-file name="ADDONSDIR/Fancybox.php" />

		<remove-dir name="LANGUAGEDIR/Fancybox" />
		<remove-dir name="THEMEDIR/scripts/fancybox" />
		<remove-dir name="THEMEDIR/css/fancybox" />

		<redirect url="?action=admin;area=packages;sa=browse" timeout="5000" />
	</uninstall>
</package-info>
